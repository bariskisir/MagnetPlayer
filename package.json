{
  "name": "magnet-player-repository",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/helper"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=12.1.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,helper \"npm run dev:web\" \"npm run dev:helper\"",
    "dev:web": "npm run dev --workspace @bariskisir/magnet-player-web",
    "dev:helper": "npm run dev --workspace magnet-player-helper",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.tools.json && tsc -p tsconfig.tests.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "npm run preview --workspace @bariskisir/magnet-player-web",
    "helper:pack": "npm pack --workspace magnet-player-helper",
    "helper:publish": "npm publish --workspace magnet-player-helper --access public",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "helper:check": "npm run build --workspace magnet-player-helper && tsx scripts/check-package.ts",
    "release:check": "tsx scripts/check-release.ts",
    "release:version": "tsx scripts/prepare-release.ts",
    "build:web": "npm run build --workspace @bariskisir/magnet-player-web"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "bufferutil@4.1.0": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "fsevents@2.3.3": true,
    "node-datachannel@0.32.3": true,
    "utf-8-validate@6.0.6": true,
    "utp-native@2.5.3": true,
    "ip-set": false
  },
  "packageManager": "npm@12.1.0"
}
